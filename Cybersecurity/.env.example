# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybersecurity_ni
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/cybersecurity_ni

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible LLM
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ni_responses

# App
APP_NAME=Cybersecurity-NI
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
